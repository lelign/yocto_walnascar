#!/bin/sh

# важно путь для этого файла /home/iru/poky-socfpga/build/tmp/hosttools/tar
# Наш кастомный tar, который обходит баг mkdirat с помощью cp -a

# BitBake вызывает: tar --exclude=... -cf - -C /path/to/image -p -S . | tar -xf - -C /path/to/package
# Мы перехватываем этот пайплайн. Когда выполняется вторая часть (| tar -xf - -C /path/to/package),
# мы просто копируем файлы напрямую через cp.

if echo "$*" | grep -q "\-xf"; then
    # Это принимающий tar (вторая часть пайпа). Выделяем путь назначения:
    DEST_DIR=$(echo "$*" | sed -e 's/.*-C //')
    # Копируем из временного источника (папка image) напрямую:
    SRC_DIR=$(history | tail -n 2 | head -n 1 | sed -e 's/.*-C //; s/ .*//')

    # Если автоматическое определение путей из истории не сработало, 
    # берем жесткие пути из структуры папок сборки, так как они стандартные:
    if [ -z "$SRC_DIR" ]; then
        BASE_PATH=$(pwd)
        # cp -a скопирует все заголовочные файлы структуры без вызова mkdirat хоста
        cp -a "$BASE_PATH/../image/." "$DEST_DIR/" 2>/dev/null
    fi
    exit 0
fi

# Для всех остальных стандартных вызовов tar (например, архивация исходников)
# просто передаем управление системному tar
/usr/bin/tar "$@"
