-int Gpio::get_value(QString file_name)
+int Gpio:: get_value(QString file_name) {
+    QFile file(fileGpio);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        qDebug() << "Failed to open file for reading:" << file.errorString();
+        return -1;
+    }
+    QTextStream in(&file);
+    QString line;
+    while (!in.atEnd()) {
+        line = in.readLine();
+        if (line.contains(file_name)) {
+            file.close();
+            QStringList list = line.split("=");       
+            return list[1].toInt();  // Return the matching line
+        }
+    }
+    file.close();
+    return-1;
+}
+
+
+void Gpio:: set_state(QString filename, const char *state) {
+    QFile file(fileGpio);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) {
+        qDebug() << "Error opening file for reading:" << file.errorString();
+        return;
+    }
+
+    QString fileContent = QTextStream(&file).readAll();
+    file.close();
+    QString newPattern = filename + "=";
+    QString newString = filename + "=" + state;
+    QRegularExpression regex(QString(".*%1.*\\n").arg(QRegularExpression::escape(newPattern)));
+    fileContent.replace(regex, newString + "\n");
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate | QIODevice::Text)) {
+        qDebug() << "Error opening file for writing:" << file.errorString();
+        return;
+    }
+
+    QTextStream out(&file);
+    out << fileContent;
+    file.close();
+    // qDebug() << "Content replaced successfully.";
+}
+
