From 5cb48fec47d4da9933d95f4864abaff7c9df822a Mon Sep 17 00:00:00 2001
From: lelign <ignatlelekin@gmail.com>
Date: Thu, 9 Jul 2026 03:38:34 +0300
Subject: [PATCH] dts: arm: a10: fix mdio phy polling flat version

Upstream-Status: Inappropriate [oe specific]

---
 .../dts/intel/socfpga/socfpga_arria10_socdk.dtsi   | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi b/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi
index 290edd106774..7a73d77fd184 100644
--- a/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi
+++ b/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi
@@ -147,9 +147,17 @@ strmem {
 	};
 };
 
+/*
+&gmac2 {
+	phy-mode = "rgmii-id";
+	phy-addr = <0xffffffff>; // probe for phy addr	
+	status = "okay";
+};
+*/
+
 &gmac2 {
 	phy-mode = "rgmii-id";
-	phy-addr = <0xffffffff>; /* probe for phy addr */	
+	phy-addr = <0>; /* fix to address 0 instead of 0xffffffff polling */
 	status = "okay";
 };
 
@@ -173,8 +181,8 @@ &i2c0 {
 	 * because the LCD module does not work at the standard 100Khz
 	 */
 	clock-frequency = <100000>;
-	i2c-sda-falling-time-ns = <6000>;
-	i2c-scl-falling-time-ns = <6000>;
+	i2c-sda-falling-time-ns = <300>;
+	i2c-scl-falling-time-ns = <300>;
 
 	/****************** коммутатор x4 pca9546 D21 mux@71 ******************/
 	/*преключает i2c на одну из 4 шин. Каждая шина обозначается как i2c@num, 
