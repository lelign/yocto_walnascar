From e91f3f4854954d762e1c0c57ae9dd3517832aba3 Mon Sep 17 00:00:00 2001
From: lelign <ignatlelekin@gmail.com>
Date: Fri, 16 Oct 2026 20:55:09 +0300
Subject: [PATCH] added tsin2@ff209840 in soc
Upstream-Status: Inappropriate [oe specific]

---
 .../boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi    | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi b/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi
index 2e72fe036966..73912177aa93 100644
--- a/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi
+++ b/arch/arm/boot/dts/intel/socfpga/socfpga_arria10_socdk.dtsi
@@ -155,6 +155,15 @@ strmem {
 				<0xFF204A00 0x80>    /* REG_SDI_CVO */		
 				;		
 		};
+
+		tsin2@ff209840 {
+			compatible = "pfrt,tsin";
+			reg = <0xff204880 0x40>; /* Адрес регистра внутри LWH2F */
+			interrupts = <0 41 4>;    /* Номер прерывания (уточните, совпадает ли IRQ на новой плате) */
+			index = <1>;
+			buf_size = <0x800>;
+			status = "okay";
+		};
 	};
 };
 
